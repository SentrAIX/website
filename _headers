# Fonts and images: 30 days. CSS/JS carry a content hash in the file name, so they can be cached for a year;
# a changed file gets a new name and the HTML (never cached) points at it.
/assets/fonts/*
  Cache-Control: public, max-age=2592000
/assets/images/*
  Cache-Control: public, max-age=2592000
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
